<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Version>4.0.1</Version>
		<PackageReleaseNotes>Fix daily recurrence scheduling with FluentScheduler 6.0.0 by using Everyday for one-day intervals while preserving configured wall-clock time, RunNow, RunOnceAt, and multi-day schedules.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentScheduler" Version="6.0.0" />
	</ItemGroup>

	<Choose>
		<When Condition=" '$(Configuration)'!='Debug' ">
			<ItemGroup>
				<PackageReference Include="Signals.Aspects.BackgroundProcessing" Version="4.0.*" />
			</ItemGroup>
		</When>

		<When Condition=" '$(Configuration)'=='Debug' ">
			<ItemGroup>
				<ProjectReference Include="..\..\..\..\src\05 Aspects\10 Background processing\Signals.Aspects.BackgroundProcessing\Signals.Aspects.BackgroundProcessing.csproj" />
			</ItemGroup>
		</When>
	</Choose>

</Project>
